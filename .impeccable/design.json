  "narrative": {
    "northStar": "深靛蓝中的光场花园",
    "overview": "以深靛蓝空间承托完整花卉原作，冷白文字负责阅读，青绿提示负责方向。大标题、平直控件与文字导航构成稳定界面，作品保留自己的全部色彩。光场由代码生成，珠光随观察动作变化；内容与入口始终独立于图形增强。\n\n本记录从当前代码提取，延续已确认的深靛蓝光场体系；本轮精修入口层级、详情阅读顺序、收藏状态与备份操作，适用首页、图录、详情、花册、备份与共享导航。它记录视觉实现，不代表正式部署、真实用户试用或实体扫描验收。首页构图策略以 surface brief 为准，不扩大为每页必须使用全屏光场。",
    "keyCharacteristics": [
      "深靛蓝空间、冷白正文、青绿方向提示。",
      "完整原作先呈现；图形失败仍可阅读和进入故事。",
      "文字导航与平直轮廓；作品页按阅读与操作需要调整密度。",
      "有限时长、输入驱动的光影，保留自然滚动与原生光标。"
    ],
    "rules": [
      {
        "name": "Artwork First",
        "body": "原作始终完整包含，不用裁切、悬停放大或 shader 遮挡替代真实纹样。",
        "section": "colors"
      },
      {
        "name": "Finite Motion",
        "body": "光场响应输入，在有限时间后停止；隐藏、离屏和减少动态效果时不保持连续绘制。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保留每款花卡自己的完整原作、比例、署名与可用媒体。",
      "Do 保持原作与故事入口在图形增强失败时可访问。",
      "Do 保持主要控件至少 44px 高，保留语义化当前项、选中态和键盘焦点。",
      "Do 让手机内容自然重排与滚动，使用真实可用的收藏和备份状态。"
    ],
    "donts": [
      "Don't 恢复装饰性玻璃导航、拟真书册阴影或全页纸色外壳。",
      "Don't 把静态截图或普通浏览记录标成实体卡识别成功。",
      "Don't 为缺失媒体、馆藏授权、生成图或真机性能编造证明。",
      "Don't 将 sidecar 的色阶预览与组件样例当成新的产品界面或运行时 token。"
    ]
  }
}
