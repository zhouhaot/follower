  "narrative": {
    "northStar": "当代博物馆数字展览",
    "overview": "以完整花卉纹样为主角，深绿展厅承托暖白文字，浅色卡缘提供观看边界。标题延续项目自托管 Exhibition 字体；局部珠光随观察动作变化，界面保持克制。\n\n本记录只适用于首页、花卡详情及其共享珠光卡组件，来自用户已确认的局部珠光样稿与两页延展。首页的浅色五卡区域属于本次范围；独立图录、收藏、导览页面不据此宣称已统一。珠光是屏幕上的数字材质近似，不是实体印刷工艺或实物效果承诺。",
    "keyCharacteristics": [
      "完整原作与五种花卉差异优先。",
      "深绿背景、暖白文字、浅色卡缘和有限导航透光。",
      "输入驱动的局部光影；静止时无持续绘制。"
    ],
    "rules": [
      {
        "name": "The Artwork First Rule",
        "body": "保留每种花卉自己的完整资源与比例；光影不得替代原作，原作入口保持可访问。",
        "section": "colors"
      },
      {
        "name": "The Finite Motion Rule",
        "body": "珠光响应输入；手动演示在 1.6 秒后结束。隐藏、离屏或静止时不持续绘制，低动态偏好不倾转。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保持完整花卉纹样可辨，使用对应原作资源与原始比例。",
      "Do 保留键盘方向键、Home 归正、纵向触摸阅读和清晰焦点。",
      "Do 让关键控件至少有 44px 高度，并保留原作、故事及现有收藏入口。",
      "Do 将图像、模块与 WebGL 故障回退到可阅读原作的路径。"
    ],
    "donts": [
      "Don't 把局部珠光扩展成整屏光晕、持续自动旋转或空闲绘制循环。",
      "Don't 将此记录当成独立图录、收藏、导览已完成统一改版的证明。",
      "Don't 将本机浏览器与模拟触摸结果写成所有实体手机流畅的保证。",
      "Don't 将数字珠光描述为已经验证的实体珠光印刷效果。"
    ]
  }
